# Copy to provision.env (trusted local shell configuration).
# Environment variables override these defaults when written as below.
LIMA_INSTANCE="${LIMA_INSTANCE:-devbox}"
LIMA_USER="${LIMA_USER:-aschuma}"
INSTALL_DOCKER="${INSTALL_DOCKER:-true}"
CONFIGURE_SHELL="${CONFIGURE_SHELL:-true}"
UPGRADE_PACKAGES="${UPGRADE_PACKAGES:-false}"
